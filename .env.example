# Server Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai-mystery-room
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECRET=super-secret-detective-key-32-chars

